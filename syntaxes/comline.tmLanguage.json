{
  "name": "Comline",
  "scopeName": "source.comline",
  "patterns": [
    { "include": "#comments" },
    { "include": "#annotations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.comline",
          "match": "//.*$"
        },
        {
          "name": "comment.block.comline",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "entity.other.attribute-name.comline",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.comline",
          "match": "\\b(struct|enum|protocol|error|const|type|settings|validator|use|import)\\b"
        },
        {
          "name": "keyword.other.comline",
          "match": "\\b(function|validate|assert|for|as|union)\\b"
        },
        {
          "name": "keyword.operator.word.comline",
          "match": "\\b(and|or)\\b"
        },
        {
          "name": "storage.modifier.comline",
          "match": "\\boptional\\b"
        },
        {
          "name": "variable.language.comline",
          "match": "\\b(self|parent|package)\\b"
        },
        {
          "name": "constant.language.comline",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.comline",
          "match": "\\b(s8|s16|s32|s64|u8|u16|u32|u64|f32|f64|bool|string)\\b"
        },
        {
          "name": "entity.name.type.comline",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.comline",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.comline",
              "match": "\\\\([\"\\\\/bfnrt]|u[0-9a-fA-F]{4})"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.comline",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.comline",
          "match": "\\b\\d+\\b"
        },
        {
          "name": "constant.numeric.hex.comline",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.comline",
          "match": "->"
        },
        {
          "name": "keyword.operator.comline",
          "match": "[=:,<>?!]"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.comline",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
