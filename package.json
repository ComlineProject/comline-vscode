{
  "name": "comline-vscode",
  "displayName": "Comline",
  "description": "Language support for Comline schema (.ids) and package (.idp) files",
  "version": "0.1.0",
  "publisher": "comline",
  "license": "MIT",
  "icon": "icons/extension-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ComlineProject/comline-vscode"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "comline",
    "ids",
    "schema",
    "language-server",
    "lsp"
  ],
  "activationEvents": [
    "workspaceContains:**/config.idp"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "comline.restartServer",
        "title": "Comline: Restart Language Server"
      },
      {
        "command": "comline.build",
        "title": "Comline: Build"
      },
      {
        "command": "comline.check",
        "title": "Comline: Check"
      },
      {
        "command": "comline.generate",
        "title": "Comline: Generate"
      },
      {
        "command": "comline.clean",
        "title": "Comline: Clean"
      },
      {
        "command": "comline.selectPackage",
        "title": "Comline: Select Active Package"
      },
      {
        "command": "comline.refreshLanguageTargets",
        "title": "Comline: Refresh Available Code-Generation Targets"
      },
      {
        "command": "comline.formatFile",
        "title": "Comline: Format File"
      },
      {
        "command": "comline.lintFile",
        "title": "Comline: Lint File"
      },
      {
        "command": "comline.menu.formatFile",
        "title": "Format Document"
      },
      {
        "command": "comline.menu.lintFile",
        "title": "Lint File"
      }
    ],
    "submenus": [
      {
        "id": "comline.fileMenu",
        "label": "Comline",
        "icon": {
          "light": "./icons/comline-light.png",
          "dark": "./icons/comline-dark.png"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "submenu": "comline.fileMenu",
          "group": "navigation",
          "when": "resourceLangId == comline || resourceLangId == comline-package"
        }
      ],
      "comline.fileMenu": [
        {
          "command": "comline.menu.formatFile",
          "group": "1_actions"
        },
        {
          "command": "comline.menu.lintFile",
          "group": "1_actions"
        }
      ],
      "commandPalette": [
        {
          "command": "comline.menu.formatFile",
          "when": "false"
        },
        {
          "command": "comline.menu.lintFile",
          "when": "false"
        }
      ]
    },
    "languages": [
      {
        "id": "comline",
        "aliases": [
          "Comline",
          "comline"
        ],
        "extensions": [
          ".ids"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/comline-light.png",
          "dark": "./icons/comline-dark.png"
        }
      },
      {
        "id": "comline-package",
        "aliases": [
          "Comline Package",
          "comline-package"
        ],
        "extensions": [
          ".idp"
        ],
        "configuration": "./language-configuration.idp.json",
        "icon": {
          "light": "./icons/comline-light.png",
          "dark": "./icons/comline-dark.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "comline",
        "scopeName": "source.comline",
        "path": "./syntaxes/comline.tmLanguage.json"
      },
      {
        "language": "comline-package",
        "scopeName": "source.comline-package",
        "path": "./syntaxes/comline-package.tmLanguage.json"
      }
    ],
    "icons": {
      "comline-mark": {
        "description": "Comline brand mark",
        "default": {
          "fontPath": "./fonts/comline-icons.woff",
          "fontCharacter": "\\E900"
        }
      }
    },
    "configuration": {
      "type": "object",
      "title": "Comline",
      "properties": {
        "comline.server.mode": {
          "type": "string",
          "enum": [
            "bundled",
            "path",
            "custom"
          ],
          "default": "bundled",
          "description": "How to locate the language server binary",
          "enumDescriptions": [
            "Use the bundled language server (default)",
            "Look for 'comline-lsp' in system PATH",
            "Use custom path specified in comline.server.customPath"
          ]
        },
        "comline.server.customPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to the language server binary (used when mode is 'custom')"
        },
        "comline.server.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug logging for the language server"
        },
        "comline.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server"
        },
        "comline.cli.mode": {
          "type": "string",
          "enum": [
            "path",
            "custom"
          ],
          "default": "path",
          "description": "How to locate the comline CLI binary used by the Build/Check/Generate/Clean commands",
          "enumDescriptions": [
            "Look for 'comline' in system PATH (default)",
            "Use custom path specified in comline.cli.customPath"
          ]
        },
        "comline.cli.customPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to the comline CLI binary (used when comline.cli.mode is 'custom')"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "yarn compile",
    "lint": "eslint src --ext ts",
    "package": "bash scripts/package.sh",
    "package:bundle": "bash scripts/package.sh --bundle-binaries",
    "link-binary": "bash scripts/link-binary.sh",
    "build:icon-font": "npx --yes fantasticon@^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
