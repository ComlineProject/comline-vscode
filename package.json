{
  "name": "comline-vscode",
  "displayName": "Comline",
  "description": "Language support for Comline schema (.ids) and package (.idp) files",
  "version": "0.1.0",
  "publisher": "comline",
  "license": "MIT",
  "icon": "icons/extension-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ComlineProject/comline-vscode"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "comline": {
    "languageServer": {
      "rev": "8590a0a11e67ef0bf0ae3e3b9c74fd705c6bdccf"
    }
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "comline",
    "ids",
    "schema",
    "language-server",
    "lsp"
  ],
  "activationEvents": [
    "workspaceContains:**/config.idp",
    "workspaceContains:**/comline.toml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "comline.restartServer",
        "title": "Comline: Restart Language Server"
      },
      {
        "command": "comline.build",
        "title": "Comline: Build"
      },
      {
        "command": "comline.check",
        "title": "Comline: Check"
      },
      {
        "command": "comline.generate",
        "title": "Comline: Generate"
      },
      {
        "command": "comline.clean",
        "title": "Comline: Clean"
      },
      {
        "command": "comline.selectPackage",
        "title": "Comline: Select Active Package"
      },
      {
        "command": "comline.refreshLanguageTargets",
        "title": "Comline: Refresh Available Code-Generation Targets"
      },
      {
        "command": "comline.formatFile",
        "title": "Comline: Format File"
      },
      {
        "command": "comline.lintFile",
        "title": "Comline: Lint File"
      },
      {
        "command": "comline.menu.formatFile",
        "title": "Format File"
      },
      {
        "command": "comline.menu.lintFile",
        "title": "Lint File"
      }
    ],
    "submenus": [
      {
        "id": "comline.fileMenu",
        "label": "Comline",
        "icon": {
          "light": "./icons/comline-light.png",
          "dark": "./icons/comline-dark.png"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "submenu": "comline.fileMenu",
          "group": "navigation",
          "when": "resourceLangId == comline || resourceLangId == comline-package || resourceLangId == comline-toml"
        }
      ],
      "comline.fileMenu": [
        {
          "command": "comline.menu.formatFile",
          "group": "1_actions"
        },
        {
          "command": "comline.menu.lintFile",
          "group": "1_actions"
        }
      ],
      "commandPalette": [
        {
          "command": "comline.menu.formatFile",
          "when": "false"
        },
        {
          "command": "comline.menu.lintFile",
          "when": "false"
        }
      ]
    },
    "languages": [
      {
        "id": "comline",
        "aliases": [
          "Comline",
          "comline"
        ],
        "extensions": [
          ".ids"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/comline-light.png",
          "dark": "./icons/comline-dark.png"
        }
      },
      {
        "id": "comline-package",
        "aliases": [
          "Comline Package",
          "comline-package"
        ],
        "extensions": [
          ".idp"
        ],
        "configuration": "./language-configuration.idp.json",
        "icon": {
          "light": "./icons/comline-light.png",
          "dark": "./icons/comline-dark.png"
        }
      },
      {
        "id": "comline-toml",
        "aliases": [
          "comline.toml"
        ],
        "filenames": [
          "comline.toml"
        ],
        "configuration": "./language-configuration.toml.json",
        "icon": {
          "light": "./icons/comline-light.png",
          "dark": "./icons/comline-dark.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "comline",
        "scopeName": "source.comline",
        "path": "./syntaxes/comline.tmLanguage.json",
        "unbalancedBracketScopes": [
          "keyword.operator.arrow.comline"
        ]
      },
      {
        "language": "comline-package",
        "scopeName": "source.comline-package",
        "path": "./syntaxes/comline-package.tmLanguage.json"
      },
      {
        "language": "comline-toml",
        "scopeName": "source.comline-toml",
        "path": "./syntaxes/comline-toml.tmLanguage.json"
      }
    ],
    "icons": {
      "comline-mark": {
        "description": "Comline brand mark",
        "default": {
          "fontPath": "./fonts/comline-icons.woff",
          "fontCharacter": "\\E900"
        }
      }
    },
    "configuration": {
      "type": "object",
      "title": "Comline",
      "properties": {
        "comline.server.mode": {
          "type": "string",
          "enum": [
            "bundled",
            "path",
            "custom",
            "host"
          ],
          "default": "bundled",
          "description": "How to locate the language server binary. Reload the window after changing it.",
          "enumDescriptions": [
            "Use the bundled language server (default). It is a static build that also runs inside a Flatpak sandbox.",
            "Run 'comline-lsp' from PATH. Inside a Flatpak (VSCodium, VS Code) the sandbox cannot see the host's PATH, so this runs it on the host through 'flatpak-spawn --host'.",
            "Run the binary at comline.server.customPath, as written (the path must be readable where the editor runs; inside a Flatpak that excludes the host's /usr).",
            "Run the language server on the host system: through 'flatpak-spawn --host' inside a Flatpak, and the same as 'path' anywhere else. Uses comline.server.customPath as the program when set, else 'comline-lsp'."
          ]
        },
        "comline.server.customPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the language server binary. Used as written (`~` is not expanded) when `#comline.server.mode#` is `custom`, and as the program to run on the host when it is `host` (an absolute path on the host, for a binary that isn't on the host's PATH, such as one in `~/.cargo/bin`)."
        },
        "comline.server.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug logging for the language server"
        },
        "comline.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server"
        },
        "comline.cli.mode": {
          "type": "string",
          "enum": [
            "path",
            "custom",
            "host"
          ],
          "default": "path",
          "description": "How to locate the comline CLI binary used by the Build/Check/Generate/Clean commands",
          "enumDescriptions": [
            "Run 'comline' from PATH (default). Inside a Flatpak (VSCodium, VS Code) the sandbox cannot see the host's PATH, so this runs it on the host through 'flatpak-spawn --host'.",
            "Run the binary at comline.cli.customPath, as written (the path must be readable where the editor runs; inside a Flatpak that excludes the host's /usr).",
            "Run the CLI on the host system: through 'flatpak-spawn --host' inside a Flatpak, and the same as 'path' anywhere else. Uses comline.cli.customPath as the program when set, else 'comline'."
          ]
        },
        "comline.cli.customPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the comline CLI binary. Used as written (`~` is not expanded) when `#comline.cli.mode#` is `custom`, and as the program to run on the host when it is `host`."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "yarn compile",
    "test": "node --test out/resolve.test.js",
    "lint": "eslint src --ext ts",
    "package": "bash scripts/package.sh",
    "link-binary": "bash scripts/link-binary.sh",
    "build:icon-font": "npx --yes fantasticon@^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
